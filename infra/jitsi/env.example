# Copier ce fichier en .env puis remplir. NE PAS COMMITER .env (secrets).
#
#   cp env.example .env
#   # generer les 3 secrets (voir README) puis les coller ci-dessous
#
# --- Reseau / domaine ------------------------------------------------------
# Domaine public servi par Caddy (doit pointer en DNS vers le serveur).
PUBLIC_URL=https://visio.pauseia.fr
# IP publique du serveur (annoncee par le pont video aux navigateurs).
SERVER_PUBLIC_IP=138.199.201.21
# Port UDP du media (a ouvrir dans le firewall Hetzner + ufw).
JVB_PORT=10000
# Fuseau horaire.
TZ=Europe/Paris

# Version des images Jitsi. "stable" pour suivre, ou une version datee pour
# figer (recommande en prod), ex. stable-9823 (voir hub.docker.com/u/jitsi).
JITSI_TAG=stable

# Dossier des fichiers de config generes par Jitsi (hors du depot).
CONFIG=/opt/volunteer-apps/data/jitsi-cfg

# --- Secrets (generer, ne pas laisser vides) -------------------------------
# openssl rand -hex 16   pour chacun, OU le script gen-passwords officiel.
JICOFO_COMPONENT_SECRET=
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
